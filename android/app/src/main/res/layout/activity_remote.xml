<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top bar: close, device name, power, overflow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btnPower"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_power"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Power" />

        <ImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_overflow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- Trackpad -->
    <com.openremote.app.TrackpadView
        android:id="@+id/trackpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_trackpad" />

    <!-- Button rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back" />
            </FrameLayout>

            <Space
                android:layout_width="34dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle">

                <ImageButton
                    android:id="@+id/btnHome"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_home"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Home" />
            </FrameLayout>

            <Space
                android:layout_width="34dp"
                android:layout_height="1dp" />

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle">

                <ImageButton
                    android:id="@+id/btnAssistant"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_assistant"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Assistant (hold to talk)" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="22dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle">

                <ImageButton
                    android:id="@+id/btnMute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_mute"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mute" />
            </FrameLayout>

            <Space
                android:layout_width="18dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="176dp"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_pill">

                <ImageButton
                    android:id="@+id/btnVolumeDown"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_volume_down"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Volume down" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/divider" />

                <ImageButton
                    android:id="@+id/btnVolumeUp"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/ic_volume_up"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Volume up" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
